      "verification": "npm run verify:addressql-api"
    },
    {
      "name": "addressql-duckdb",
      "path": "extensions/addressql-duckdb",
      "readiness": "scaffold-ready",
      "verification": "npm run verify:addressql-duckdb"
    },
    {
      "name": "addressql-js-ts",
      "path": "sdk/addressql-js-ts",
