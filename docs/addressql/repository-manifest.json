{
  "schema_version": "addressql-repository-manifest-v0.1",
  "owner": "dawnportinfo-design",
  "repository": "addressql",
  "visibility": "public",
  "status": "release-candidate",
  "description": "Portable SQL/SDK functions for structured, postal-aware, delivery-aware, privacy-bound address queries.",
  "license_policy": {
    "code": "Apache-2.0",
    "papers_and_specs": "CC-BY-4.0",
    "data": "source-specific; synthetic fixtures only in public tests; optional postcode-only runtime sync stays untracked"
  },
  "topics": [
    "address-validation",
    "postgresql",
    "postgis",
    "duckdb",
    "geospatial",
    "logistics",
    "privacy",
    "zero-knowledge",
    "open-source"
  ],
  "public_packages": [
    {
      "name": "addressql-spec",
      "path": "docs/addressql",
      "readiness": "ready",
      "verification": "npm run verify:addressql"
    },
    {
      "name": "addressql-postgres",
      "path": "extensions/addressql-postgres",
      "readiness": "scaffold-ready",
      "verification": "npm run verify:addressql-postgres"
    },
    {
      "name": "addressql-core",
      "path": "native/addressql-core",
      "readiness": "scaffold-ready",
      "verification": "npm run verify:addressql-core"
    },
    {
      "name": "addressql-global-country-preload",
      "path": "src/lib/addressQlGlobalCountryPreload.ts",
      "readiness": "preload-contract-ready",
      "verification": "npm run verify:addressql-global-preload"
    },
    {
      "name": "addressql-global-country-coverage",
      "path": "src/lib/addressQlGlobalCountryCoverage.ts",
      "readiness": "capability-gate-ready",
      "verification": "npm run verify:addressql-global-coverage"
    },
    {
      "name": "addressql-country-data-promotion",
      "path": "src/lib/addressQlCountryDataPromotion.ts",
      "readiness": "p2-review-candidate-index-ready",
      "verification": "npm run verify:addressql-country-data-promotion"
    },
    {
      "name": "addressql-multilingual-quality",
      "path": "src/lib/addressQlMultilingualQuality.ts",
      "readiness": "p3-quality-gate-index-ready",
      "verification": "npm run verify:addressql-multilingual-quality"
    },
    {
      "name": "addressql-practical-api",
      "path": "src/lib/addressQlPracticalApi.ts",
      "readiness": "p1-self-hosted-api-ready",
      "verification": "npm run verify:addressql-api"
    },
    {
      "name": "addressql-runtime-evidence-adapters",
      "path": "src/lib/addressQlRuntimeAdapter.ts",
      "readiness": "fail-closed-attestation-gate-ready",
      "verification": "npm run verify:addressql-api"
    },
    {
      "name": "addressql-postal-set-adapter",
      "path": "src/lib/addressQlPostalSetAdapter.ts",
      "readiness": "approved-dataset-loader-ready",
      "verification": "npm run verify:addressql-api"
    },
    {
      "name": "addressql-runtime-config",
      "path": "src/lib/addressQlRuntimeConfig.ts",
