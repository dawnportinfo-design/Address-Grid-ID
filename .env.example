# .env.example
# All APIs used in this app are open-source or free-tier without keys.

# Local development server.
# Set AGID_HMR_PORT when running multiple AGID worktrees so Vite websocket ports do not collide.
PORT=3000
AGID_HMR_PORT=
VITE_HMR_PORT=
DISABLE_HMR=false

# Optional Gemini fallback geocoding. Leave empty to keep the local server quiet and OSS-first.
GEMINI_API_KEY=

# Optional background quality monitor. Leave false during local development and CI to avoid external geo traffic.
AGID_ENABLE_QUALITY_SWEEP=false

# Optional postal-code preload. Leave empty/0 for lazy local startup; downloads require explicit opt-in.
AGID_POSTAL_PRELOAD_COUNTRIES=
AGID_POSTAL_PRELOAD_LOCAL=0
AGID_POSTAL_PRELOAD_DOWNLOAD=0

# Optional credentialed national geo APIs. Leave empty to fail closed instead of sending placeholder tokens.
TIANDITU_TOKEN=
INEGI_TOKEN=

# Security and privacy defaults.
# Keep log redaction enabled unless a local-only debugging session explicitly needs raw server logs.
AGID_LOG_REDACTION=
AGID_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGID_CONTENT_SECURITY_POLICY=frame-ancestors 'self'

# Optional Oracle Hospitality OPERA / OHIP integration.
# Keep OPERA_DRY_RUN=true until the hotel tenant, Oracle app, gateway, and audit policy are approved.
OPERA_ENABLED=false
OPERA_DRY_RUN=true
OPERA_ADMIN_TOKEN=
OPERA_ENDPOINT_KIND=profile-address
OPERA_BASE_URL=
OPERA_TOKEN_URL=
OPERA_CLIENT_ID=
OPERA_CLIENT_SECRET=
OPERA_ACCESS_TOKEN=
OPERA_APP_KEY=
OPERA_HOTEL_ID=
OPERA_ENTERPRISE_ID=
OPERA_SCOPE=
OPERA_ADDRESS_SYNC_PATH=
OPERA_ADDRESS_SYNC_METHOD=POST
OPERA_TIMEOUT_MS=15000
OPERA_RETRIES=0
OPERA_RETURN_RAW_RESPONSE=false
OPERA_GATEWAY_ALLOWLIST=
OPERA_SECRET_STORAGE=vault
OPERA_ALLOWED_HOTEL_IDS=
OPERA_ALLOWED_TENANT_IDS=
OPERA_ALLOWED_ADDRESS_TYPES=HOME,BUSINESS,OTHER
OPERA_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
OPERA_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# Connector execution tokens. Keep these server-side only.
AGID_EXTERNAL_POS_CONNECTOR_TOKEN=
AGID_EXTERNAL_DELIVERY_CONNECTOR_TOKEN=
AGID_EXTERNAL_VALIDATOR_CONNECTOR_TOKEN=
AGID_LIBPOSTAL_CONNECTOR_TOKEN=
AGID_TRANSLATION_CONNECTOR_TOKEN=

# Plaintext connector policies. Leave false until the target connector, DPA, and audit policy are approved.
AGID_EXTERNAL_POS_ALLOW_PLAINTEXT=false
AGID_EXTERNAL_POS_ALLOW_RAW_RESPONSE=false
AGID_EXTERNAL_DELIVERY_ALLOW_PLAINTEXT=false
AGID_EXTERNAL_DELIVERY_ALLOW_LABEL_PAYLOAD=false
AGID_EXTERNAL_VALIDATOR_ALLOW_PLAINTEXT=false
AGID_LIBPOSTAL_ALLOW_PLAINTEXT=false
AGID_TRANSLATION_ALLOW_PLAINTEXT=false

# Terminal signing for nullifier/mark-used replay protection.
AGID_REGISTRY_TERMINAL_SIGNING_SECRET=
AGID_POS_TERMINAL_SIGNING_SECRET=

# Production database guard. Set strict or NODE_ENV=production to fail closed on unsafe DB URLs.
AGID_DB_PRODUCTION_GUARD=
AGID_DB_MIGRATIONS_APPLIED=false
AGID_DB_AUDIT_LOG_ENABLED=false
AGID_ADDRESS_LEDGER_MIGRATIONS_APPLIED=false
AGID_ADDRESS_LEDGER_AUDIT_LOG_ENABLED=false
AGID_POS_REGISTRY_MIGRATIONS_APPLIED=false
AGID_POS_REGISTRY_AUDIT_LOG_ENABLED=false
