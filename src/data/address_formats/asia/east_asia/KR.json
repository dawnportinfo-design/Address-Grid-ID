{
  "countryCode": "KR",
  "name": "South Korea",
  "native": {
    "name": "대한민국",
    "addressFormat": "{{postcode}}\n{{state}}\n{{city}}\n{{street}} {{houseNumber}}\n{{organization}}\n{{name}}",
    "ordering": "big-to-small",
    "fields": [
      { "key": "postcode", "label": "우편번호", "placeholder": "06164", "required": true, "type": "text" },
      { "key": "state", "label": "시/도", "placeholder": "서울특별시", "required": true, "type": "text" },
      { "key": "city", "label": "시/군/구", "placeholder": "강남구", "required": true, "type": "text" },
      { "key": "street", "label": "도로명+건물번호", "placeholder": "영동대로 513", "required": true, "type": "text" },
      { "key": "organization", "label": "상세주소", "placeholder": "코엑스 101호", "required": false, "type": "text" },
      { "key": "name", "label": "이름", "placeholder": "홍길동", "required": false, "type": "text" }
    ]
  },
  "english": {
    "addressFormat": "{{postcode}}\n{{state}}\n{{city}}\n{{street}}\n{{organization}}\n{{name}}",
    "ordering": "small-to-big",
    "fields": [
      { "key": "state", "label": "Province/Metro", "placeholder": "Seoul", "required": true, "type": "text" },
      { "key": "city", "label": "District", "placeholder": "Gangnam-gu", "required": true, "type": "text" },
      { "key": "street", "label": "Road+No.", "placeholder": "Yeongdong-daero 513", "required": true, "type": "text" },
      { "key": "organization", "label": "Detail", "placeholder": "COEX Room 101", "required": false, "type": "text" },
      { "key": "name", "label": "Name", "placeholder": "Hong Gil-dong", "required": false, "type": "text" },
      { "key": "postcode", "label": "Postal Code", "placeholder": "06164", "required": true, "type": "text" }
    ]
  },
  "postalCode": {
    "format": "NNNNN",
    "regex": "^\\d{5}$",
    "api": "https://www.epost.go.kr/search.RetrieveAddressIdInfo.comm",
    "source": "Korea Post"
  }
}