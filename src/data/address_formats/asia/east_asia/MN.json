      { "key": "street", "label": "Гудамж", "placeholder": "Энх тайвны өргөн чөлөө", "required": false, "type": "text" },
      { "key": "organization", "label": "Байр", "placeholder": "10-24", "required": false, "type": "text" },
      { "key": "name", "label": "Нэр", "placeholder": "Бат", "required": false, "type": "text" }
