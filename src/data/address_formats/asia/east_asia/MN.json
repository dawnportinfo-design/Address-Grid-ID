  },
  "english": {
    "addressFormat": "{{postcode}}\n{{state}}\n{{city}}\n{{district}}\n{{street}}\n{{organization}}\n{{name}}",
    "ordering": "small-to-big",
    "fields": [
      { "key": "state", "label": "Province", "placeholder": "Ulaanbaatar", "required": true, "type": "text" },
      { "key": "city", "label": "Soum", "placeholder": "Sukhbaatar", "required": true, "type": "text" },
