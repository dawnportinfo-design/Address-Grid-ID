      { "key": "city", "label": "City", "placeholder": "St. Thomas", "required": true, "type": "text" },
      { "key": "state", "label": "VI", "placeholder": "VI", "required": true, "type": "text" },
      { "key": "postcode", "label": "ZIP Code", "placeholder": "00802", "required": true, "type": "text" }
    ]
  },
