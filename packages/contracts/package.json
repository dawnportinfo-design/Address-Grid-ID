{
  "name": "@agid/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./agid-contract": "./src/agidContract.ts",
    "./postal-source-promotion-gate": "./src/postalSourcePromotionGate.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "verify": "npm --prefix ../.. run verify:contracts-workspace"
  },
  "agidWorkspace": {
    "role": "versioned contracts, schemas, and conformance gates",
    "migrationPhase": "owned-source-with-legacy-facade",
    "repositoryStatus": "source-owned-release-gated",
    "legacyEntrypoints": [
      "src/lib/agidContract.ts",
      "src/address/postalSourcePromotionGate.ts"
    ]
  }
}
